{
  "stryker-config": {
    "project": "AssetProvenanceHelper.csproj",
    "solution": "../../AssetProvenanceHelper.sln",
    "reporters": [
      "progress",
      "html"
    ],
    "thresholds": {
      "high": 90,
      "low": 80,
      "break": 80
    },
    "mutate": [
      "**/Services/*.cs",
      "**/Models/*.cs",
      "**/MainForm.cs",
      "**/MainForm.MainWorkflow.cs",
      "**/MainForm.ReferenceWorkflow.cs",
      "**/MainForm.Recovery.cs",
      "!**/MainForm.Designer.cs"
    ]
  }
}
